DATABASE_URL=postgresql+psycopg://fakeanand@localhost:5432/linguaear
SECRET_KEY=change-me

# AI provider key; used only by the backend
GROQ_API_KEY=
# Optional overrides (defaults shown)
# GROQ_TEXT_MODEL=openai/gpt-oss-20b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# LIMIT_ANALYZE_PER_DAY=20
# LIMIT_GAME_PER_DAY=30
# LIMIT_SCAN_PER_DAY=10
# LIMIT_TRANSCRIBE_PER_DAY=40
# MAX_SAVED_PHRASES=100

# Subscriptions (Stripe). Use test-mode keys while developing.
# BILLING_ENFORCED=false lifts the paywall locally; leave it true in production.
BILLING_ENFORCED=true
TRIAL_DAYS=7
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
# Text shown on the paywall (the real price is the one set on the Stripe price)
# PRICE_LABEL_STANDARD=4.99 EUR / month
# PRICE_LABEL_PRO=9.99 EUR / month
# Public URL of this API, where Stripe returns people after checkout
PUBLIC_BASE_URL=http://localhost:8765

# Email verification (6-digit code). Codes need a working SMTP server above (SMTP_HOST, SMTP_PORT,
# SMTP_USER, SMTP_PASSWORD, SMTP_FROM). For Gmail: smtp.gmail.com, port 587, an App Password, and SMTP_FROM
# set to the same Gmail address.
# VERIFICATION_CODE_MINUTES=10
# VERIFICATION_RESEND_SECONDS=60
# VERIFICATION_MAX_ATTEMPTS=5
# REQUIRE_VERIFIED_FOR_ACCESS=true
# Development only: also print every email (including the code) in the server log
# LOG_EMAIL_BODIES=true
